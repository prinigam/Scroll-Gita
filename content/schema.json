{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "sample": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": ["string", "null"]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "url",
          "license",
          "attribution",
          "version"
        ]
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verse_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["number", "title", "verse_count"]
      }
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^([1-9]|1[0-8])\\.[1-9][0-9]*$"
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "verse": {
            "type": "integer",
            "minimum": 1
          },
          "sanskrit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "transliteration": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "translations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["text", "source_id"]
              },
              "hi": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["text", "source_id"]
              }
            },
            "required": ["en", "hi"]
          }
        },
        "required": [
          "ref",
          "chapter",
          "verse",
          "sanskrit",
          "source_id",
          "translations"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "content_version",
    "sample",
    "sources",
    "chapters",
    "verses"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
